# Only identifiers and sizes live here. Passwords are generated by Terraform (random_password) and never typed.

variable "gcp_project_id" {
  description = "Google Cloud project that hosts the core (created by the owner, see docs/despliegue-en-la-nube.md)."
  type        = string
}

variable "gcp_region" {
  description = "Region of Cloud Run and Artifact Registry. A tier 1 region keeps the Cloud Run free tier and sits near Supabase us-east-1."
  type        = string
  default     = "us-east1"
}

variable "github_repository" {
  description = "owner/name of the repository whose GitHub Actions may deploy (Workload Identity Federation)."
  type        = string
  default     = "MauricioTorrez1/pos-saas"

  validation {
    condition     = can(regex("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", var.github_repository))
    error_message = "Use the owner/name form, for example MauricioTorrez1/pos-saas."
  }
}

variable "github_deploy_environment" {
  description = "GitHub environment whose jobs may impersonate the deployer. It carries the manual approval."
  type        = string
  default     = "production"
}

variable "core_service_name" {
  description = "Name of the Cloud Run service of the core."
  type        = string
  default     = "pos-core"
}

variable "core_initial_image" {
  description = "Image of the first revision only. Later revisions come from the deploy workflow, so Terraform ignores the image after creation."
  type        = string
  default     = "us-docker.pkg.dev/cloudrun/container/hello"
}

variable "core_max_instances" {
  description = "Upper bound of Cloud Run instances. It caps cost and the connections to the Supabase pooler."
  type        = number
  default     = 2

  validation {
    condition     = var.core_max_instances >= 1 && var.core_max_instances <= 5
    error_message = "Keep between 1 and 5 instances: each one opens up to 4 database connections."
  }
}

variable "core_memory" {
  description = "Memory of each Cloud Run instance."
  type        = string
  default     = "1Gi"
}

variable "oidc_issuer_uri" {
  description = "Issuer of the Keycloak realm that signs the tokens of the panel. Empty keeps the default of the core until Keycloak has a home in production (ADR 0077)."
  type        = string
  default     = ""
}

variable "supabase_organization_id" {
  description = "Slug of the Supabase organization (Dashboard > Organization settings)."
  type        = string
}

variable "supabase_project_name" {
  description = "Name of the Supabase project."
  type        = string
  default     = "pos-saas"
}

variable "supabase_region" {
  description = "AWS region of the Supabase project."
  type        = string
  default     = "us-east-1"
}

variable "supabase_pooler_host" {
  description = "Override of the Supavisor pooler host (Supabase > Connect > Session pooler). Empty reads it from the provider."
  type        = string
  default     = ""
}

variable "cloudflare_account_id" {
  description = "Cloudflare account that holds the R2 bucket of the backups."
  type        = string
}

variable "backup_bucket_name" {
  description = "Name of the R2 bucket of the encrypted database backups."
  type        = string
  default     = "pos-saas-backups"
}

variable "backup_daily_retention_days" {
  description = "Days an object under daily/ lives before R2 deletes it."
  type        = number
  default     = 30
}

variable "backup_monthly_retention_days" {
  description = "Days an object under monthly/ lives before R2 deletes it (about twelve months)."
  type        = number
  default     = 365
}

variable "billing_account_id" {
  description = "Billing account for the budget alert. Empty skips the budget."
  type        = string
  default     = ""
}

variable "budget_alert_amount_usd" {
  description = "Monthly amount, in whole US dollars, that triggers the budget e-mails. The plan is to spend 0."
  type        = number
  default     = 1
}
