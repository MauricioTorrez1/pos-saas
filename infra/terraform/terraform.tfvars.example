# Copy to terraform.tfvars (ignored by Git) and fill in. Only identifiers go here, never a password or token:
# Terraform generates the database passwords, and the provider tokens come from environment variables.

gcp_project_id           = "your-gcp-project-id"
supabase_organization_id = "your-supabase-organization-slug"
cloudflare_account_id    = "your-cloudflare-account-id"

# Only if the provider cannot read the pooler: the host of Supabase > Connect > Session pooler.
# supabase_pooler_host = "aws-0-us-east-1.pooler.supabase.com"

# Optional: the e-mail alert as soon as anything is charged. Find it with `gcloud billing accounts list`.
# billing_account_id = "000000-000000-000000"

# Optional: defaults shown.
# gcp_region         = "us-east1"
# supabase_region    = "us-east-1"
# github_repository  = "MauricioTorrez1/pos-saas"
# core_max_instances = 2
