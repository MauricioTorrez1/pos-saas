# Copy this file to .env for local development.
# Keep real values out of Git. Use test credentials only in development.

# PostgreSQL
POSTGRES_DB=pos_saas
POSTGRES_USER=
POSTGRES_PASSWORD=

# Keycloak
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# Redis
REDIS_PASSWORD=

# Encrypts each tenant's third-party keys stored in the database
TENANT_SECRETS_MASTER_KEY=

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Facturapi
FACTURAPI_API_KEY=

# Sentry
SENTRY_DSN=

# Claude API
ANTHROPIC_API_KEY=
