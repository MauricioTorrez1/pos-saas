# Run scripts/create-dev-env.sh to create .env with random local passwords, or to add new variables to it.
# Keep real values out of Git. Use test credentials only in development.

# Lets docker compose run from the repository root
COMPOSE_FILE=infra/compose/compose.yaml

# PostgreSQL
POSTGRES_DB=pos_saas
POSTGRES_USER=pos_admin
POSTGRES_PASSWORD=

# Keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Redis
REDIS_PASSWORD=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Encrypts each tenant's third-party keys stored in the database
TENANT_SECRETS_MASTER_KEY=

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Facturapi
FACTURAPI_API_KEY=

# Sentry
SENTRY_DSN=

# Claude API
ANTHROPIC_API_KEY=
