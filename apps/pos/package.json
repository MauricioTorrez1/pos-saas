{
  "name": "@pos-saas/pos",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop register built with Electron, React, and TypeScript.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --composite false && tsc -p tsconfig.web.json --composite false && tsc -p tsconfig.test.json --composite false",
    "test": "vitest run && electron-vite build && install-electron && playwright test",
    "package": "electron-vite build && electron-builder --win --publish never",
    "package:dir": "electron-vite build && electron-builder --win --dir --publish never",
    "crash-drill": "electron-vite build && install-electron && node e2e/crash-drill.ts"
  },
  "dependencies": {
    "@pos-saas/money": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@pos-saas/contracts": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "exceljs": "^4.4.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
