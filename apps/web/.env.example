# Copy to .env.local for local development. Keep real values out of Git.

# Realm "pos" of the Keycloak from `docker compose --profile core up` (ADR 0039)
PANEL_OIDC_ISSUER_URL=http://localhost:8180/realms/pos
PANEL_OIDC_CLIENT_ID=pos-panel

# Public address of the panel. It must match a redirect URI of the client in the realm
PANEL_BASE_URL=http://localhost:3000

# Spring Boot core, called only from the server of the panel
PANEL_CORE_API_URL=http://localhost:8080

# Encrypts the session cookie. At least 32 characters. Create one with: openssl rand -base64 48
PANEL_SESSION_SECRET=
