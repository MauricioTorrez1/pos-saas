{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Line amount cases",
  "description": "Cases for round_half_up(unit_price_e4 * quantity_milli / 100000), the line amount formula of ADR 0011.",
  "type": "object",
  "required": ["amounts", "rejections"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "amounts": {
      "description": "Inputs that must produce an amount.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/amount_case" }
    },
    "rejections": {
      "description": "Inputs that must fail instead of producing an amount.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rejection_case" }
    }
  },
  "$defs": {
    "amount_case": {
      "type": "object",
      "required": ["name", "unit_price_e4", "quantity_milli", "unit", "expected_amount_cents"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/case_name" },
        "unit_price_e4": { "$ref": "values.schema.json#/$defs/unit_price_e4", "minimum": 0 },
        "quantity_milli": { "$ref": "values.schema.json#/$defs/quantity_milli", "minimum": 0 },
        "unit": { "$ref": "values.schema.json#/$defs/unit" },
        "expected_amount_cents": { "$ref": "values.schema.json#/$defs/amount_cents", "minimum": 0 }
      }
    },
    "rejection_case": {
      "type": "object",
      "required": ["name", "unit_price_e4", "quantity_milli", "unit", "expected_error"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/case_name" },
        "unit_price_e4": { "$ref": "values.schema.json#/$defs/unit_price_e4" },
        "quantity_milli": { "$ref": "values.schema.json#/$defs/quantity_milli" },
        "unit": { "$ref": "values.schema.json#/$defs/unit" },
        "expected_error": { "enum": ["negative_input", "fractional_piece", "overflow"] }
      }
    },
    "case_name": {
      "description": "Shown when the case fails, so it says what the case protects.",
      "type": "string",
      "minLength": 1
    }
  }
}
