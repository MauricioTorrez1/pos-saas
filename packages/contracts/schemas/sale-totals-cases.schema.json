{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sale totals cases",
  "description": "Cases for the totals of a sale (ADR 0023): each line is split from its own total and rate, and the sale adds up the lines, with one group per factor and rate, highest rate first and exempt last.",
  "type": "object",
  "required": ["sales", "rejections"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "sales": {
      "description": "Lines that must add up to these totals.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sale_case" }
    },
    "rejections": {
      "description": "Lines that must fail instead of adding up.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rejection_case" }
    }
  },
  "$defs": {
    "sale_case": {
      "type": "object",
      "required": [
        "name",
        "lines",
        "expected_subtotal_cents",
        "expected_tax_cents",
        "expected_total_cents",
        "expected_tax_groups"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/case_name" },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/sale_line" } },
        "expected_subtotal_cents": { "$ref": "values.schema.json#/$defs/amount_cents", "minimum": 0 },
        "expected_tax_cents": { "$ref": "values.schema.json#/$defs/amount_cents", "minimum": 0 },
        "expected_total_cents": { "$ref": "values.schema.json#/$defs/amount_cents", "minimum": 0 },
        "expected_tax_groups": { "type": "array", "items": { "$ref": "#/$defs/tax_group" } }
      }
    },
    "sale_line": {
      "description": "A line already rounded, VAT included, with its rate.",
      "type": "object",
      "required": ["total_cents", "tax_factor", "tax_rate_bp"],
      "additionalProperties": false,
      "allOf": [{ "$ref": "values.schema.json#/$defs/exempt_has_no_rate" }],
      "properties": {
        "total_cents": { "$ref": "values.schema.json#/$defs/amount_cents", "minimum": 0 },
        "tax_factor": { "$ref": "values.schema.json#/$defs/tax_factor" },
        "tax_rate_bp": { "$ref": "values.schema.json#/$defs/valid_tax_rate_bp" }
      }
    },
    "tax_group": {
      "type": "object",
      "required": ["tax_factor", "tax_rate_bp", "base_cents", "tax_cents"],
      "additionalProperties": false,
      "allOf": [{ "$ref": "values.schema.json#/$defs/exempt_has_no_rate" }],
      "properties": {
        "tax_factor": { "$ref": "values.schema.json#/$defs/tax_factor" },
        "tax_rate_bp": { "$ref": "values.schema.json#/$defs/valid_tax_rate_bp" },
        "base_cents": { "$ref": "values.schema.json#/$defs/amount_cents", "minimum": 0 },
        "tax_cents": { "$ref": "values.schema.json#/$defs/amount_cents", "minimum": 0 }
      }
    },
    "rejection_case": {
      "type": "object",
      "required": ["name", "lines", "expected_error"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/case_name" },
        "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rejection_line" } },
        "expected_error": { "enum": ["negative_input", "overflow", "invalid_tax_rate"] }
      }
    },
    "rejection_line": {
      "type": "object",
      "required": ["total_cents", "tax_factor", "tax_rate_bp"],
      "additionalProperties": false,
      "properties": {
        "total_cents": { "$ref": "values.schema.json#/$defs/amount_cents" },
        "tax_factor": { "type": "string", "minLength": 1 },
        "tax_rate_bp": { "$ref": "values.schema.json#/$defs/tax_rate_bp" }
      }
    },
    "case_name": {
      "description": "Shown when the case fails, so it says what the case protects.",
      "type": "string",
      "minLength": 1
    }
  }
}
